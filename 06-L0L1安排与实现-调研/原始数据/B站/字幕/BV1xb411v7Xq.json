 100.82, "to": 101.66, "sid": 75, "location": 2, "content": "然后再听下一个"}, {"from": 101.66, "to": 103.0, "sid": 76, "location": 2, "content": "这样练习是没有什么意义的"}, {"from": 103.0, "to": 105.4, "sid": 77, "location": 2, "content": "这样的话呢你就会养成习惯之后再听呢"}, {"from": 105.4, "to": 107.3, "sid": 78, "location": 2, "content": "就特别容易忽略理解这部分"}, {"from": 107.3, "to": 108.74, "sid": 79, "location": 2, "content": "脑子里都是分散的"}, {"from": 108.74, "to": 110.6, "sid": 80, "location": 2, "content": "这些单词在这儿呢我挑了一个材料"}, {"from": 110.6, "to": 112.13, "sid": 81, "location": 2, "content": "然后呢来给大家演示一下"}, {"from": 112.13, "to": 115.49, "sid": 82, "location": 2, "content": "scientists have recreated a nineteen eighty five"}, {"from": 115.49, "to": 117.41, "sid": 83, "location": 2, "content": "study of birds in peru"}, {"from": 117.41, "to": 120.08, "sid": 84, "location": 2, "content": "that shows climate change is pushing them"}, {"from": 120.08, "to": 121.73, "sid": 85, "location": 2, "content": "moda jal environment"}, {"from": 121.73, "to": 122.9, "sid": 86, "location": 2, "content": "相对偏长的句子呢"}, {"from": 122.9, "to": 123.92, "sid": 87, "location": 2, "content": "你是可以中断的"}, {"from": 123.92, "to": 124.94, "sid": 88, "location": 2, "content": "但是中断地方要注意"}, {"from": 124.94, "to": 127.27, "sid": 89, "location": 2, "content": "你可以从某些啊应该断句的地方"}, {"from": 127.27, "to": 129.31, "sid": 90, "location": 2, "content": "比如说从句的地方是可以断开的"}, {"from": 129.31, "to": 130.9, "sid": 91, "location": 2, "content": "比如说我们从中间切断一下"}, {"from": 130.9, "to": 134.2, "sid": 92, "location": 2, "content": "scientists have recreated a nineteen eighty five"}, {"from": 134.2, "to": 136.46, "sid": 93, "location": 2, "content": "study of birds in peru"}, {"from": 145.96, "to": 147.24, "sid": 94, "location": 2, "content": "好这一部分写完之后呢"}, {"from": 147.24, "to": 148.46, "sid": 95, "location": 2, "content": "我们继续往下放"}, {"from": 148.6, "to": 151.84, "sid": 96, "location": 2, "content": "scientists have recreated a nineteen eighty"}, {"from": 151.84, "to": 152.14, "sid": 97, "location": 2, "content": "five"}, {"from": 152.14, "to": 154.06, "sid": 98, "location": 2, "content": "study of birds in peru"}, {"from": 154.06, "to": 158.64, "sid": 99, "location": 2, "content": "that shows that change is pushing them for their natural environment"}, {"from": 168.059, "to": 169.099, "sid": 100, "location": 2, "content": "好那这样一来呢"}, {"from": 169.099, "to": 170.54, "sid": 101, "location": 2, "content": "我们就完成了我们的第一句话"}, {"from": 170.54, "to": 172.88, "sid": 102, "location": 2, "content": "scientists have recreated and animate live"}, {"from": 172.88, "to": 173.24, "sid": 103, "location": 2, "content": "studio"}, {"from": 173.24, "to": 175.94, "sid": 104, "location": 2, "content": "buds in peru that shows climate changes"}, {"from": 175.94, "to": 178.27, "sid": 105, "location": 2, "content": "pushing them from their natural environment"}, {"from": 178.27, "to": 179.41, "sid": 106, "location": 2, "content": "那因为我能听慢速的"}, {"from": 179.41, "to": 180.82, "sid": 107, "location": 2, "content": "这句话是没有什么问题"}, {"from": 180.82, "to": 182.65, "sid": 108, "location": 2, "content": "如果就是你在平常练的时候"}, {"from": 182.65, "to": 184.3, "sid": 109, "location": 2, "content": "你听第一遍没太听懂的话"}, {"from": 184.3, "to": 185.98, "sid": 110, "location": 2, "content": "你还可以反复多次听到"}, {"from": 185.98, "to": 187.36, "sid": 111, "location": 2, "content": "其实有人会有这样的困扰"}, {"from": 187.36, "to": 188.74, "sid": 112, "location": 2, "content": "就是我好像听懂了"}, {"from": 188.74, "to": 190.3, "sid": 113, "location": 2, "content": "但是我写的时候写不出来"}, {"from": 190.3, "to": 191.44, "sid": 114, "location": 2, "content": "好像都忘掉一样"}, {"from": 191.44, "to": 193.8, "sid": 115, "location": 2, "content": "那这个到底是你记忆力有问题吗"}, {"from": 193.8, "to": 194.82, "sid": 116, "location": 2, "content": "你不是的"}, {"from": 194.82, "to": 195.3, "sid": 117, "location": 2, "content": "相信我"}, {"from": 195.3, "to": 196.68, "sid": 118, "location": 2, "content": "你就是没有完全懂"}, {"from": 196.68, "to": 198.3